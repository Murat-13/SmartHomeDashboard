<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Разговор через домофон (docs/talk-tz.md): голос в динамик домофона; запрашивается при первом «Говорить». -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Самообновление из GitHub Releases (этап 09): установка проверенного APK через PackageInstaller;
         на Android 12+ — без окна подтверждения, если система разрешит. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Запись с камер на планшет (docs/recording.md): сервис переднего плана specialUse, решение владельца 18.11.2026. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".SmartHomeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartHomeDashboard"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false" />

        <!-- Запись с камер: круглосуточная запись без участия экрана. -->
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous recording of the user's own doorbell and security cameras to local storage" />
        </service>

        <!-- Режим «главный экран»: включается в настройках (HomeScreenMode). Тогда Android сам открывает
             панель после перезагрузки, по кнопке «Домой» и после падения. -->
        <activity-alias
            android:name=".HomeLauncher"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Одна панель на устройство: запуск с рабочего стола и как главного экрана не создаёт
             вторую копию с ещё одним соединением с HA. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartHomeDashboard.Modern" />

        <activity
            android:name=".VoiceAlertsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartHomeDashboard.Modern" />

        <activity
            android:name=".SensorPickerActivity"
            android:exported="false" />

        <activity
            android:name=".TileSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartHomeDashboard.Modern" />

        <activity
            android:name=".AdvancedWidgetSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartHomeDashboard.Modern" />
        <activity android:name=".ChildButtonsEditorActivity" android:exported="false" />
        <activity android:name=".BatteryModernEditorActivity" android:exported="false" />
        <activity android:name=".PowerModernEditorActivity" android:exported="false" />
        <activity android:name=".HomeClimateEditorActivity" android:exported="false" />
        <activity android:name=".InverterModernEditorActivity" android:exported="false" />
        <activity android:name=".DoorbellEditorActivity" android:exported="false" />
        <!-- Калитки и ворота (docs/gate-tz.md): список проходов и редактор одного прохода, тема Modern. -->
        <activity
            android:name=".GatesActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartHomeDashboard.Modern" />
        <activity
            android:name=".GateEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SmartHomeDashboard.Modern" />
        <!-- Плитка «Калитка или ворота» (docs/gate-tz.md, решение 3): какой проход она показывает. -->
        <activity
            android:name=".GateTileEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SmartHomeDashboard.Modern" />
        <!-- Архив записей (docs/recording.md, этап 3): Compose, тема Modern. -->
        <activity
            android:name=".ArchiveActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.SmartHomeDashboard.Modern" />
        <!-- «Поделиться» роликом архива: только копия в cache/archive_share, доступ по разовому разрешению. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/archive_share_paths" />
        </provider>

        <!-- Результат сессии установки обновления (PendingIntent от PackageInstaller). -->
        <receiver
            android:name=".UpdateInstaller$StatusReceiver"
            android:exported="false" />
        <!-- После замены приложения новой версией: журнал и повторное открытие панели. -->
        <receiver
            android:name=".UpdateInstaller$ReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>