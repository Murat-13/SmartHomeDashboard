<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Временно исключаем смешанные настройки целиком: в них ещё есть открытые секреты.
         tiles_prefs.xml и остальные данные сохраняют стандартное участие в backup. -->
    <exclude domain="sharedpref" path="dashboard_prefs.xml" />
    <!-- Внутренние автокопии, копии «перед обновлением» и сохранённые повреждённые плитки (files/backups/)
         содержат адреса Home Assistant и координаты дома — в облако Google их не передаём.
         Выбранная владельцем папка копий (SAF) здесь не затрагивается. -->
    <exclude domain="file" path="backups/" />
</full-backup-content>
