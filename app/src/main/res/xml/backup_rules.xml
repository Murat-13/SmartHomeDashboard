<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Временно исключаем смешанные настройки целиком: в них ещё есть открытые секреты.
         tiles_prefs.xml и остальные данные сохраняют стандартное участие в backup. -->
    <exclude domain="sharedpref" path="dashboard_prefs.xml" />
    <!-- Внутренние автокопии, копии «перед обновлением» и сохранённые повреждённые плитки (files/backups/)
         содержат адреса Home Assistant и координаты дома — в облако Google их не передаём.
         Выбранная владельцем папка копий (SAF) здесь не затрагивается. -->
    <exclude domain="file" path="backups/" />
    <!-- История мощности (до десятков МБ) не идёт в облачную квоту Android: у неё свой бэкап в папку копий. -->
    <exclude domain="database" path="power_history.db" />
    <exclude domain="database" path="power_history.db-journal" />
    <!-- Запись с камер: «записывать на этом планшете» и лимиты — только этого планшета; видео — не в облако. -->
    <exclude domain="sharedpref" path="recording_device.xml" />
    <!-- Прямые события с камер: флаг, секрет вебхука, слот и отпечаток сертификата — только этого планшета. -->
    <exclude domain="sharedpref" path="camera_events.xml" />
    <exclude domain="external" path="records/" />
    <!-- Снимки посетителей при звонке и фразы голосом владельца — только этого планшета, не в облако. -->
    <exclude domain="file" path="doorbell_rings/" />
    <!-- Уведомление на телефон и автоответ — с одного выбранного планшета: не переносим на другой. -->
    <exclude domain="sharedpref" path="doorbell_away.xml" />
    <exclude domain="file" path="doorbell_phrases/" />
    <exclude domain="database" path="recording_index.db" />
    <exclude domain="database" path="recording_index.db-journal" />
</full-backup-content>
