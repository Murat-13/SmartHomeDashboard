<?xml version="1.0" encoding="utf-8"?>
<!-- Стили Modern для настроек и редакторов. Главная панель их не использует и не меняется. -->
<resources>
    <!-- Тёмная тема экранов настроек/редакторов; подключается к экрану на его этапе. -->
    <style name="Theme.SmartHomeDashboard.Modern" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/modern_accent</item>
        <item name="colorOnPrimary">@color/modern_on_accent</item>
        <item name="colorSecondary">@color/modern_accent</item>
        <item name="colorError">@color/modern_error</item>
        <item name="colorSurface">@color/modern_surface</item>
        <item name="colorOnSurface">@color/modern_text_primary</item>
        <item name="colorControlActivated">@color/modern_accent</item>
        <item name="android:colorBackground">@color/modern_background</item>
        <item name="android:windowBackground">@color/modern_background</item>
        <item name="android:textColorPrimary">@color/modern_text_primary</item>
        <item name="android:textColorSecondary">@color/modern_text_secondary</item>
        <item name="android:textColorHint">@color/modern_text_hint</item>
        <item name="android:statusBarColor">@color/modern_background</item>
        <item name="android:navigationBarColor">@color/modern_background</item>
    </style>

    <style name="TextAppearance.Modern.Header" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/modern_text_header</item>
        <item name="android:textColor">@color/modern_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Modern.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/modern_text_title</item>
        <item name="android:textColor">@color/modern_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Modern.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/modern_text_body</item>
        <item name="android:textColor">@color/modern_text_primary</item>
    </style>
    <style name="TextAppearance.Modern.Secondary" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/modern_text_body</item>
        <item name="android:textColor">@color/modern_text_secondary</item>
    </style>
    <style name="TextAppearance.Modern.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/modern_text_caption</item>
        <item name="android:textColor">@color/modern_text_hint</item>
    </style>

    <style name="Widget.Modern.Section" parent="">
        <item name="android:background">@drawable/modern_bg_section</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/modern_space_l</item>
    </style>

    <style name="Widget.Modern.Input" parent="">
        <item name="android:background">@drawable/modern_bg_input</item>
        <item name="android:minHeight">@dimen/modern_touch_target</item>
        <item name="android:paddingStart">@dimen/modern_space_m</item>
        <item name="android:paddingEnd">@dimen/modern_space_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Modern.Body</item>
        <item name="android:textColorHint">@color/modern_text_hint</item>
    </style>

    <!-- Кнопки — MaterialButton: в теме Material3 так их создаёт и XML-инфлейтер. -->
    <style name="Widget.Modern.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/modern_button_primary_bg</item>
        <item name="android:textColor">@color/modern_on_accent</item>
        <item name="cornerRadius">@dimen/modern_radius_control</item>
        <item name="android:minHeight">@dimen/modern_touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/modern_text_body</item>
    </style>
    <style name="Widget.Modern.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/modern_accent</item>
        <item name="android:textColor">@color/modern_accent</item>
        <item name="rippleColor">@color/modern_accent_soft</item>
        <item name="cornerRadius">@dimen/modern_radius_control</item>
        <item name="android:minHeight">@dimen/modern_touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/modern_text_body</item>
    </style>
    <!-- Только для удаления и рискованных действий. -->
    <style name="Widget.Modern.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/modern_danger</item>
        <item name="android:textColor">@color/modern_danger</item>
        <item name="rippleColor">@color/modern_danger_soft</item>
        <item name="cornerRadius">@dimen/modern_radius_control</item>
        <item name="android:minHeight">@dimen/modern_touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/modern_text_body</item>
    </style>

    <style name="Widget.Modern.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/modern_switch_thumb</item>
        <item name="trackTint">@color/modern_switch_track</item>
        <item name="android:minHeight">@dimen/modern_touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.Modern.Body</item>
    </style>

    <style name="Widget.Modern.NavItem" parent="">
        <item name="android:background">@drawable/modern_bg_nav_item</item>
        <item name="android:minHeight">@dimen/modern_touch_target</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/modern_space_m</item>
        <item name="android:paddingEnd">@dimen/modern_space_m</item>
        <item name="android:drawablePadding">@dimen/modern_space_m</item>
        <item name="android:textColor">@color/modern_nav_text</item>
        <item name="android:textSize">@dimen/modern_text_body</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
