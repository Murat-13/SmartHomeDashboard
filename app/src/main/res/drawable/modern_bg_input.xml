<?xml version="1.0" encoding="utf-8"?>
<!-- Поле ввода: тонкая рамка, в фокусе — бирюзовая. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_surface_input" />
            <stroke android:width="2dp" android:color="@color/modern_accent" />
            <corners android:radius="@dimen/modern_radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_surface_input" />
            <stroke android:width="1dp" android:color="@color/modern_border" />
            <corners android:radius="@dimen/modern_radius_control" />
        </shape>
    </item>
</selector>
