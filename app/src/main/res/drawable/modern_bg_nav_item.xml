<?xml version="1.0" encoding="utf-8"?>
<!-- Пункт левого меню: выбранный — мягкий бирюзовый, без ярких эффектов. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_accent_soft" />
            <corners android:radius="@dimen/modern_radius_control" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_pressed_overlay" />
            <corners android:radius="@dimen/modern_radius_control" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
