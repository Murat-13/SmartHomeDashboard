<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">


    <!-- Кнопки (свободное размещение поверх всего) -->
    <FrameLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Оверлей для раскрытия сенсоров -->
    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvHaLiveStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:padding="6dp"
        android:textColor="#CCCCCC"
        android:background="#801A1A1A"
        android:textSize="12sp"
        android:maxLines="2" />

    <!-- Подсказка: как войти в редактирование и что в нём можно. Текст не перехватывает
         касания панели; нажимается только крестик. -->
    <LinearLayout
        android:id="@+id/panelHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_hint"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPanelHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="720dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnPanelHintClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Закрыть подсказку"
            android:src="@drawable/ic_close"
            app:tint="#B3FFFFFF" />
    </LinearLayout>

    <!-- Затемнение -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"
        android:visibility="gone" />

</FrameLayout>