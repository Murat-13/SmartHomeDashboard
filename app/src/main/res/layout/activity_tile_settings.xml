<?xml version="1.0" encoding="utf-8"?>
<!-- Единый редактор плитки: вкладки «Основное / Вид / Данные», внизу всегда «Удалить · Отмена · Сохранить».
     ID полей прежние; запись — только кнопкой «Сохранить». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/modern_background"
        app:navigationContentDescription="Назад"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/tile_settings_title"
        app:titleTextColor="@color/modern_text_primary" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/editorTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/modern_background"
        app:tabIndicatorColor="@color/modern_accent"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/modern_accent"
        app:tabTextColor="@color/modern_text_secondary" />

    <ScrollView
        android:id="@+id/editorScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/modern_space_l"
            android:paddingTop="@dimen/modern_space_l"
            android:paddingEnd="@dimen/modern_space_l"
            android:paddingBottom="@dimen/modern_space_l">

            <!-- ===== Основное ===== -->
            <LinearLayout
                android:id="@+id/tabMain"
                style="@style/Widget.Modern.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView style="@style/SettingsLabel" android:layout_marginTop="0dp" android:text="@string/tile_title_label" />

                <EditText
                    android:id="@+id/etTileTitle"
                    style="@style/Widget.Modern.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/tile_title_hint"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <TextView style="@style/SettingsLabel" android:text="@string/tile_type_label" />

                <Spinner
                    android:id="@+id/spinnerTileType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/modern_bg_input"
                    android:entries="@array/tile_types"
                    android:popupBackground="@color/modern_surface" />

                <!-- Что делает выбранный тип и какие устройства выбирать -->
                <LinearLayout
                    android:id="@+id/tileTypeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/modern_space_s"
                    android:background="@drawable/bg_hint"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvTileTypeHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/modern_text_secondary"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnTileTypeHintClose"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="top"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Закрыть подсказку"
                        android:src="@drawable/ic_close"
                        app:tint="#99FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvButtonSizeLabel"
                    style="@style/SettingsLabel"
                    android:text="Размер кнопки (px)"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etButtonSize"
                    style="@style/Widget.Modern.Input"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:hint="160"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===== Вид (кнопки и группы) ===== -->
            <LinearLayout
                android:id="@+id/tabLook"
                style="@style/Widget.Modern.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <!-- Стиль кнопки/группы и предпросмотр. Записывается только по «Сохранить». -->
                <LinearLayout
                    android:id="@+id/buttonStyleSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Стиль"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnStyleClassic"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Classic"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF" />

                        <Button
                            android:id="@+id/btnStyleModern"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Modern"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/buttonStylePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#0E1A26"
                        android:minHeight="140dp"
                        android:padding="16dp" />

                    <!-- Иконка Modern-кнопки/группы: сетку вариантов строит TileStyleEditor. -->
                    <TextView
                        android:id="@+id/tvModernIconLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="Иконка кнопки"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <FrameLayout
                        android:id="@+id/modernIconPicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Данные ===== -->
            <LinearLayout
                android:id="@+id/tabData"
                style="@style/Widget.Modern.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/sensorEditorContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/legacySourcesLabel"
                    style="@style/SettingsLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/sensors_label" />

                <LinearLayout
                    android:id="@+id/legacySourceButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSelectSensors"
                        style="@style/Widget.Modern.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/select_sensors" />

                    <Button
                        android:id="@+id/btnClearSensors"
                        style="@style/Widget.Modern.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Очистить выбор"
                        android:text="✕" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedSensors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/none_selected"
                    android:textAppearance="@style/TextAppearance.Modern.Caption" />

                <Button
                    android:id="@+id/btnEditChildren"
                    style="@style/Widget.Modern.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Устройства и имена кнопок"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnAdvanced"
                    style="@style/Widget.Modern.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Расширенные настройки" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Единые действия: удаление отдельно слева, отмена и сохранение справа. -->
    <LinearLayout
        android:id="@+id/sensorEditorFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/modern_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/modern_space_l"
        android:paddingTop="@dimen/modern_space_s"
        android:paddingEnd="@dimen/modern_space_l"
        android:paddingBottom="@dimen/modern_space_s">

        <Button
            android:id="@+id/btnDelete"
            style="@style/Widget.Modern.Button.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSensorCancel"
            style="@style/Widget.Modern.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Отмена" />

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.Modern.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/modern_space_m"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
