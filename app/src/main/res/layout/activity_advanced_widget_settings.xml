<?xml version="1.0" encoding="utf-8"?>
<!-- Расширенные настройки плитки — оформление Modern (0.9.2, этап 6): те же поля, ID и логика, что раньше. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/modern_background"
        app:navigationContentDescription="Назад"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Расширенные настройки"
        app:titleTextColor="@color/modern_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/modern_space_l"
        android:paddingEnd="@dimen/modern_space_l"
        android:paddingBottom="@dimen/modern_space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Размер шрифта -->
            <LinearLayout style="@style/Widget.Modern.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/etFontSize"
                    android:text="Размер шрифта (sp)"
                    android:textAppearance="@style/TextAppearance.Modern.Title" />

                <EditText
                    android:id="@+id/etFontSize"
                    style="@style/Widget.Modern.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/modern_space_s"
                    android:autofillHints=""
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:text="16" />
            </LinearLayout>

            <!-- Датчики в свёрнутом виде -->
            <LinearLayout style="@style/Widget.Modern.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/modern_space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Датчики в свёрнутом виде"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <Button
                        android:id="@+id/btnAddCollapsed"
                        style="@style/Widget.Modern.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Добавить датчик в свёрнутый вид"
                        android:text="+ Добавить" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCollapsedHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/modern_space_s"
                    android:background="@drawable/modern_bg_input"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/modern_touch_target"
                    android:paddingStart="@dimen/modern_space_m"
                    android:paddingEnd="@dimen/modern_space_m"
                    android:text="Список пуст"
                    android:textAppearance="@style/TextAppearance.Modern.Secondary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCollapsedSensors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/modern_space_s"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Датчики в развёрнутом виде -->
            <LinearLayout style="@style/Widget.Modern.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/modern_space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Датчики в развёрнутом виде"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <Button
                        android:id="@+id/btnAddExpanded"
                        style="@style/Widget.Modern.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Добавить датчик в развёрнутый вид"
                        android:text="+ Добавить" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExpandedHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/modern_space_s"
                    android:background="@drawable/modern_bg_input"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/modern_touch_target"
                    android:paddingStart="@dimen/modern_space_m"
                    android:paddingEnd="@dimen/modern_space_m"
                    android:text="Список пуст"
                    android:textAppearance="@style/TextAppearance.Modern.Secondary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvExpandedSensors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/modern_space_s"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Условия смены цвета -->
            <LinearLayout style="@style/Widget.Modern.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/modern_space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Условия смены цвета"
                    android:textAppearance="@style/TextAppearance.Modern.Title" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="Если значение датчика попадает в диапазон «от — до», фон плитки окрашивается выбранным цветом. Цвет — нажмите на квадрат." />

                <Button
                    android:id="@+id/btnAddColorRule"
                    style="@style/Widget.Modern.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/modern_space_m"
                    android:text="+ Добавить условие" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvColorRules"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="@dimen/modern_space_s"
                    android:nestedScrollingEnabled="true" />
            </LinearLayout>

            <!-- Кнопки -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/modern_space_xl"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancel"
                    style="@style/Widget.Modern.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/modern_space_s"
                    android:layout_weight="1"
                    android:text="Отмена" />

                <Button
                    android:id="@+id/btnSave"
                    style="@style/Widget.Modern.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/modern_space_s"
                    android:layout_weight="1"
                    android:text="Сохранить" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
