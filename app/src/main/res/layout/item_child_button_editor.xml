<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка группы: перетаскивание, номер, имя, устройство (нажатие — заменить) и удаление. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#2A2A2A"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivDragHandle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_drag_handle"
            android:contentDescription="Перетащить"
            app:tint="#888888"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvChildOrder"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etChildName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:padding="8dp"
                android:hint="Название кнопки"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <!-- Устройство кнопки. Нажатие открывает выбор другого устройства. -->
            <LinearLayout
                android:id="@+id/btnReplaceChild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Заменить устройство"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvChildEntityId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="switch.xxx"
                    android:textColor="#BDBDBD"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Заменить"
                    android:textColor="#81C784"
                    android:textSize="14sp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnChildPower"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Потребляемая мощность: выключено"
                android:textAllCaps="false" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRemoveChild"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Удалить кнопку из группы"
            android:src="@drawable/ic_delete"
            app:tint="#E57373" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
