<?xml version="1.0" encoding="utf-8"?>
<!-- Настройки: слева пять разделов, справа содержимое выбранного. ID полей прежние. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/modern_background"
        app:navigationContentDescription="Назад"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_title"
        app:titleTextColor="@color/modern_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/settingsNavScroll"
            android:layout_width="@dimen/modern_nav_width"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/settingsNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/modern_space_m"
                android:paddingEnd="@dimen/modern_space_m"
                android:paddingBottom="@dimen/modern_space_l" />
        </ScrollView>

        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/modern_space_l"
                android:paddingEnd="@dimen/modern_space_xl"
                android:paddingBottom="@dimen/modern_space_xl">

                <!-- ===== Соединения ===== -->
                <LinearLayout
                    android:id="@+id/sectionConnections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/Widget.Modern.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Home Assistant"
                            android:textAppearance="@style/TextAppearance.Modern.Title" />

                        <TextView
                            android:id="@+id/tvHaConnectionStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_s"
                            android:text="Статус: Неизвестно"
                            android:textAppearance="@style/TextAppearance.Modern.Secondary" />

                        <TextView style="@style/SettingsLabel" android:text="@string/local_host_label" />

                        <EditText
                            android:id="@+id/etHaLocalHost"
                            style="@style/Widget.Modern.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/local_host_hint"
                            android:importantForAutofill="no"
                            android:inputType="textUri" />

                        <TextView style="@style/SettingsLabel" android:text="@string/remote_host_label" />

                        <EditText
                            android:id="@+id/etHaRemoteHost"
                            style="@style/Widget.Modern.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/remote_host_hint"
                            android:importantForAutofill="no"
                            android:inputType="textUri" />

                        <TextView
                            android:id="@+id/tvHaTransportWarning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_s"
                            android:textColor="@color/modern_warning"
                            android:textSize="@dimen/modern_text_caption"
                            android:visibility="gone" />

                        <!-- Видна только для внешнего адреса без шифрования; включение — через предупреждение. -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/cbAllowInsecureRemote"
                            style="@style/Widget.Modern.Switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_s"
                            android:text="@string/allow_insecure_remote"
                            android:visibility="gone" />

                        <TextView style="@style/SettingsLabel" android:text="@string/ha_token_label" />

                        <TextView
                            android:id="@+id/tvHaTokenStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Проверка токена HA..."
                            android:textAppearance="@style/TextAppearance.Modern.Secondary" />

                        <EditText
                            android:id="@+id/etHaToken"
                            style="@style/Widget.Modern.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_s"
                            android:fontFamily="sans-serif"
                            android:hint="Новый токен; пусто — оставить сохранённый"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:saveEnabled="false" />

                        <Button
                            android:id="@+id/btnSave"
                            style="@style/Widget.Modern.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_l"
                            android:text="Проверить и сохранить" />

                        <TextView
                            style="@style/SettingsHint"
                            android:text="Новый адрес и токен сохраняются только после успешного подключения. Если проверка не прошла, остаётся прежнее подключение." />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.Modern.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Яндекс Погода"
                            android:textAppearance="@style/TextAppearance.Modern.Title" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/cbUseYandexWeather"
                            style="@style/Widget.Modern.Switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_s"
                            android:text="Использовать Яндекс Погоду" />

                        <TextView
                            android:id="@+id/tvYandexKeyStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Чтение настроек Яндекса..."
                            android:textAppearance="@style/TextAppearance.Modern.Secondary" />

                        <TextView style="@style/SettingsLabel" android:text="Ключ API Яндекса" />

                        <EditText
                            android:id="@+id/etYandexApiKey"
                            style="@style/Widget.Modern.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:hint="Новый ключ; пусто — оставить сохранённый"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:saveEnabled="false" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/modern_space_m"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView style="@style/SettingsLabel" android:text="Широта" />

                                <EditText
                                    android:id="@+id/etYandexLat"
                                    style="@style/Widget.Modern.Input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="numberDecimal" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView style="@style/SettingsLabel" android:text="Долгота" />

                                <EditText
                                    android:id="@+id/etYandexLon"
                                    style="@style/Widget.Modern.Input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="numberDecimal" />
                            </LinearLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnSaveWeather"
                            style="@style/Widget.Modern.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_l"
                            android:text="Сохранить" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Экран ===== -->
                <LinearLayout
                    android:id="@+id/sectionScreen"
                    style="@style/Widget.Modern.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Датчик движения и затемнение"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/cbMotionEnabled"
                        style="@style/Widget.Modern.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_s"
                        android:text="Использовать датчик движения" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_s"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/modern_touch_target"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMotionSensor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Датчик движения: Не выбран"
                            android:textAppearance="@style/TextAppearance.Modern.Body" />

                        <Button
                            android:id="@+id/btnSelectMotionSensor"
                            style="@style/Widget.Modern.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Выбрать" />

                        <Button
                            android:id="@+id/btnClearMotionSensor"
                            style="@style/Widget.Modern.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/modern_space_s"
                            android:contentDescription="Убрать датчик движения"
                            android:text="Убрать" />
                    </LinearLayout>

                    <TextView style="@style/SettingsLabel" android:text="Затемнение после бездействия (минуты)" />

                    <EditText
                        android:id="@+id/etScreenTimeout"
                        style="@style/Widget.Modern.Input"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:text="5" />

                    <TextView
                        style="@style/SettingsHint"
                        android:text="Без движения экран тускнеет до минимума, при движении или касании возвращается системная яркость. Если датчик выключен, экран всегда с обычной яркостью." />

                    <TextView style="@style/SettingsLabel" android:text="Возврат на главную страницу (секунды без касаний)" />

                    <EditText
                        android:id="@+id/etHomeTimeout"
                        style="@style/Widget.Modern.Input"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_xl"
                        android:text="Отображение"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <TextView style="@style/SettingsLabel" android:text="Единицы температуры" />

                    <RadioGroup
                        android:id="@+id/rgTempUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbCelsius"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/modern_touch_target"
                            android:text="°C"
                            android:textAppearance="@style/TextAppearance.Modern.Body" />

                        <RadioButton
                            android:id="@+id/rbFahrenheit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/modern_space_l"
                            android:minHeight="@dimen/modern_touch_target"
                            android:text="°F"
                            android:textAppearance="@style/TextAppearance.Modern.Body" />
                    </RadioGroup>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/cbModernHaptics"
                        style="@style/Widget.Modern.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_s"
                        android:text="Виброотклик кнопок Modern" />
                </LinearLayout>

                <!-- ===== Безопасность ===== -->
                <LinearLayout
                    android:id="@+id/sectionSecurity"
                    style="@style/Widget.Modern.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PIN администратора"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <EditText
                        android:id="@+id/etAdminPin"
                        style="@style/Widget.Modern.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_s"
                        android:importantForAutofill="noExcludeDescendants"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:saveEnabled="false" />

                    <TextView style="@style/SettingsLabel" android:text="Время сессии PIN (1–1000 минут)" />

                    <EditText
                        android:id="@+id/etPinSessionMinutes"
                        style="@style/Widget.Modern.Input"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:text="60" />

                    <TextView
                        style="@style/SettingsHint"
                        android:text="Сессия продлевается действиями администратора. Обычное управление домом PIN не требует." />

                    <Button
                        android:id="@+id/btnEndAdmin"
                        style="@style/Widget.Modern.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_l"
                        android:text="Завершить админ-режим" />
                </LinearLayout>

                <!-- ===== Устройство ===== -->
                <LinearLayout
                    android:id="@+id/sectionDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout style="@style/Widget.Modern.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Планшет"
                            android:textAppearance="@style/TextAppearance.Modern.Title" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/cbKioskMode"
                            style="@style/Widget.Modern.Switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_s"
                            android:text="Режим киоска (закрепление экрана)" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/cbHomeScreen"
                            style="@style/Widget.Modern.Switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Открывать панель автоматически (главный экран)" />

                        <TextView
                            android:id="@+id/tvHomeScreenStatus"
                            style="@style/SettingsHint"
                            android:minHeight="@dimen/modern_touch_target" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.Modern.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Резервные копии"
                            android:textAppearance="@style/TextAppearance.Modern.Title" />

                        <TextView
                            style="@style/SettingsHint"
                            android:text="В файл входят плитки, адреса Home Assistant, координаты погоды и настройки панели. Токен Home Assistant, ключ Яндекса и PIN в файл не входят — после восстановления на новом планшете их нужно ввести заново." />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_m"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnExport"
                                style="@style/Widget.Modern.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Экспорт в файл" />

                            <Button
                                android:id="@+id/btnImport"
                                style="@style/Widget.Modern.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/modern_space_m"
                                android:text="Импорт из файла" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_l"
                            android:text="Автоматические копии"
                            android:textAppearance="@style/TextAppearance.Modern.Body" />

                        <TextView
                            android:id="@+id/tvBackupStatus"
                            style="@style/SettingsHint" />

                        <TextView
                            style="@style/SettingsHint"
                            android:text="Раз в сутки ночью, только если что-то изменилось; хранятся 3 последние. Выбранная папка сохраняется даже при удалении приложения." />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_m"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnBackupFolder"
                                style="@style/Widget.Modern.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Папка для копий" />

                            <Button
                                android:id="@+id/btnBackupNow"
                                style="@style/Widget.Modern.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/modern_space_m"
                                android:text="Сделать копию сейчас" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnBackupRestore"
                            style="@style/Widget.Modern.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_m"
                            android:text="Восстановить из копии" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_l"
                            android:text="История мощности"
                            android:textAppearance="@style/TextAppearance.Modern.Body" />

                        <TextView
                            android:id="@+id/tvPowerBackupStatus"
                            style="@style/SettingsHint" />

                        <TextView
                            style="@style/SettingsHint"
                            android:text="Отдельная копия графиков электропитания: раз в сутки около 4:00 в ту же папку, хранятся 3 последние. Настройки в неё не входят." />

                        <Button
                            android:id="@+id/btnPowerHistoryRestore"
                            style="@style/Widget.Modern.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/modern_space_m"
                            android:text="Восстановить историю мощности" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== О приложении ===== -->
                <LinearLayout
                    android:id="@+id/sectionAbout"
                    style="@style/Widget.Modern.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SmartHomeDashboard"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <TextView
                        android:id="@+id/tvAppVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_s"
                        android:textAppearance="@style/TextAppearance.Modern.Secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_xl"
                        android:text="Обновления"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <TextView
                        android:id="@+id/tvUpdateStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_s"
                        android:textAppearance="@style/TextAppearance.Modern.Secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_m"
                        android:text="Канал обновлений"
                        android:textAppearance="@style/TextAppearance.Modern.Body" />

                    <RadioGroup
                        android:id="@+id/rgUpdateChannel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbUpdateStable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/modern_touch_target"
                            android:text="Стабильный"
                            android:textAppearance="@style/TextAppearance.Modern.Body" />

                        <RadioButton
                            android:id="@+id/rbUpdateTest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/modern_space_l"
                            android:minHeight="@dimen/modern_touch_target"
                            android:text="Тестовый"
                            android:textAppearance="@style/TextAppearance.Modern.Body" />
                    </RadioGroup>

                    <TextView
                        style="@style/SettingsHint"
                        android:text="Тестовый — новые версии сразу после выпуска. Стабильный — только проверенные. Проверка — раз в 6 часов при наличии интернета; найденное обновление скачивается и проверяется (SHA-256 и подпись). Перед установкой делается копия настроек." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_m"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCheckUpdates"
                            style="@style/Widget.Modern.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Проверить сейчас" />

                        <Button
                            android:id="@+id/btnInstallUpdate"
                            style="@style/Widget.Modern.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/modern_space_m"
                            android:text="Установить обновление"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUpdateInstall"
                        style="@style/SettingsHint"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/cbNightInstall"
                        style="@style/Widget.Modern.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_m"
                        android:text="Устанавливать ночью автоматически" />

                    <TextView
                        android:id="@+id/tvNightInstallHint"
                        style="@style/SettingsHint"
                        android:text="Около 3:30: только без окна подтверждения Android и только после удачной копии настроек. Включайте после того, как установка по кнопке прошла без окна." />

                    <Button
                        android:id="@+id/btnUpdateLog"
                        style="@style/Widget.Modern.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_m"
                        android:text="Журнал обновлений" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_xl"
                        android:text="Подсказки и справка"
                        android:textAppearance="@style/TextAppearance.Modern.Title" />

                    <TextView
                        style="@style/SettingsHint"
                        android:text="Закрытые крестиком подсказки можно вернуть здесь." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/modern_space_m"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnHelp"
                            style="@style/Widget.Modern.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Как пользоваться" />

                        <Button
                            android:id="@+id/btnRestoreHints"
                            style="@style/Widget.Modern.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/modern_space_m"
                            android:text="Вернуть скрытые подсказки" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
